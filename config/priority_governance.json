{
  "governance_hierarchy": {
    "description": "5-level parameter governance hierarchy for GEO-COCHABAMBA 360 microclimates. Higher priority levels override lower ones.",
    "levels": [
      {
        "priority": 1,
        "name": "In-Situ Sensors",
        "description": "Direct ground-truth measurements from deployed sensor networks",
        "data_source": "local_sensor_network",
        "applicable_parameters": ["temperature", "wind_speed", "humidity", "solar_radiation"],
        "override_rules": {
          "can_override": [],
          "overridden_by": ["manual_expert_override"],
          "requires_validation": true,
          "min_confidence": 0.95
        }
      },
      {
        "priority": 2,
        "name": "Remote Sensing (NASA/Satellite)",
        "description": "Satellite-derived observations from NASA Earthdata and other remote sensing platforms",
        "data_source": "nasa_earthdata",
        "applicable_parameters": ["temperature", "humidity", "solar_radiation"],
        "override_rules": {
          "can_override": ["numerical_weather_prediction", "climatological_defaults", "model_prediction"],
          "overridden_by": ["in_situ_sensors", "manual_expert_override"],
          "requires_validation": true,
          "min_confidence": 0.85
        }
      },
      {
        "priority": 3,
        "name": "Numerical Weather Prediction",
        "description": "Outputs from NWP models such as GFS, HRRR, and ERA5 reanalysis",
        "data_source": "nwp_models",
        "applicable_parameters": ["temperature", "wind_speed", "humidity", "solar_radiation"],
        "override_rules": {
          "can_override": ["climatological_defaults", "model_prediction"],
          "overridden_by": ["in_situ_sensors", "remote_sensing", "manual_expert_override"],
          "requires_validation": true,
          "min_confidence": 0.75
        }
      },
      {
        "priority": 4,
        "name": "Model Prediction (FNO)",
        "description": "Predictions generated by the Local-FNO digital twin model",
        "data_source": "local_fno_model",
        "applicable_parameters": ["temperature", "wind_speed", "humidity"],
        "override_rules": {
          "can_override": ["climatological_defaults"],
          "overridden_by": ["in_situ_sensors", "remote_sensing", "numerical_weather_prediction", "manual_expert_override"],
          "requires_validation": true,
          "min_confidence": 0.70
        }
      },
      {
        "priority": 5,
        "name": "Climatological Defaults",
        "description": "Long-term climatological averages and baseline values used as fallback",
        "data_source": "climatological_database",
        "applicable_parameters": ["temperature", "wind_speed", "humidity", "solar_radiation"],
        "override_rules": {
          "can_override": [],
          "overridden_by": ["in_situ_sensors", "remote_sensing", "numerical_weather_prediction", "model_prediction", "manual_expert_override"],
          "requires_validation": false,
          "min_confidence": 0.50
        }
      }
    ],
    "manual_expert_override": {
      "description": "Expert manual override that can supersede any priority level",
      "requires_justification": true,
      "audit_log": true
    }
  },
  "validation_ranges": {
    "temperature": {
      "min": -40.0,
      "max": 60.0,
      "unit": "°C",
      "description": "Valid temperature range"
    },
    "wind_speed": {
      "min": 0.0,
      "max": 50.0,
      "unit": "m/s",
      "description": "Valid wind speed range"
    },
    "humidity": {
      "min": 0.0,
      "max": 100.0,
      "unit": "%",
      "description": "Valid relative humidity range"
    },
    "solar_radiation": {
      "min": 0.0,
      "max": 1400.0,
      "unit": "W/m²",
      "description": "Valid solar radiation range"
    }
  },
  "conflict_resolution": {
    "strategy": "priority_weighted",
    "description": "When multiple sources provide conflicting values, the highest-priority source with sufficient confidence takes precedence. If confidence is below the minimum threshold, the next-highest priority source is used.",
    "logging": true,
    "alert_on_conflict": true
  }
}
