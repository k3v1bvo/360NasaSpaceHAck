# =============================================================================
# FLAME IN FREEFALL — NASA SPACE APPS CHALLENGE 2026
# VARIABLES DE ENTORNO REQUERIDAS PARA PRODUCCIÓN Y DESPLIEGUE
# =============================================================================

# 1. Conexión a Base de Datos Supabase (Opcional - Tolerancia offline automática)
# Obtén tu URL y clave anónima en el panel de Supabase: Project Settings -> API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anonima-publica-aqui

# 2. Clave de Inteligencia Artificial Generativa en Vivo (Opcional)
# Si se configura, el Asistente IA consulta Google Gemini en vivo con el corpus NASA inyectado.
# Si se omite, la app opera 100% autónoma en lenguaje natural con su motor semántico local RAG.
VITE_GEMINI_API_KEY=tu-clave-gemini-aqui

# 3. Configuración de Entorno de Misión
VITE_APP_ENV=production
VITE_MISSION_ID=NASA-PSI-FLAME-EXP-2026

# NOTA DE TOLERANCIA A FALLOS:
# Si estas variables no están definidas, la aplicación conmuta automáticamente 
# al motor de almacenamiento local (LocalStorage / IndexedDB) y motor semántico NLP local,
# garantizando operatividad completa incluso en órbita sin internet.
